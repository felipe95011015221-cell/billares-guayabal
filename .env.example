# ============================================================
# Billares Guayabal — variables de entorno
# Copie este archivo a .env.local (desarrollo) o configúrelas en Vercel.
# NUNCA suba claves reales al repositorio.
# ============================================================

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.su-dominio.com

# --- Sesión del panel administrativo (OBLIGATORIA) ---
# Cadena aleatoria de 32+ caracteres. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Supabase (PRODUCCIÓN) ---
# Si faltan, el sitio funciona en MODO DEMOSTRACIÓN (solo desarrollo) o con formularios
# desactivados que remiten a WhatsApp (producción).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor. Nunca la exponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solo MODO DEMOSTRACIÓN local (sin Supabase) ---
# No hay credenciales por defecto: si no las define, el panel no permite ingresar.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=

# --- Google Analytics 4 (opcional) ---
NEXT_PUBLIC_GA_ID=
